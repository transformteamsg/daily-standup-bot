{
  "name": "tfx-slack-bot",
  "version": "1.0.0",
  "description": "Slack standup bot with async DM collection and channel summaries",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run tests/core --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest watch",
    "build": "tsc",
    "build:slack": "esbuild src/handlers/slack.ts --bundle --platform=node --target=node20 --outfile=dist/handlers/slack.js --format=esm --external:pg-native",
    "build:tick": "esbuild src/handlers/tick.ts --bundle --platform=node --target=node20 --outfile=dist/handlers/tick.js --format=esm --external:pg-native",
    "build:lambda": "pnpm build:slack && pnpm build:tick",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@slack/bolt": "^4.1.0",
    "@slack/web-api": "^7.13.0",
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.0",
    "uuid": "^11.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
